<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon - Add Param" Width="500" Height="720" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="#F3F5F9">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E1E5EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="16,10,16,0"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7385"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="#1B2540" Padding="16,12,16,14">
            <StackPanel>
                <TextBlock Text="FALCON" Foreground="#6E9BFF" FontWeight="Bold" FontSize="10"/>
                <TextBlock Text="Add Param" Foreground="White" FontWeight="Bold" FontSize="20"/>
                <TextBlock Text="Add a shared parameter to families or to specific types"
                           Foreground="#C5CCDB" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- 1. families / types -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{StaticResource Step}">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Choose families / types" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox DockPanel.Dock="Top" x:Name="search" Height="24" Padding="3,2"
                         TextChanged="search_changed" ToolTip="Search categories, families and types"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="counter" Style="{StaticResource Small}"
                           Text="0 family(ies) ticked  |  0 type(s) ticked"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Small}" TextWrapping="Wrap"
                           Text="Tick a family: instance parameter (Properties palette, tags, schedules). Tick a type: type parameter, value set on that type only."/>
                <TreeView x:Name="tree" Margin="0,6,0,0" BorderBrush="#E1E5EE"/>
            </DockPanel>
        </Border>

        <!-- 2. parameter -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Style="{StaticResource Step}">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Parameter" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Parameter name" Style="{StaticResource Small}"/>
                <TextBox x:Name="param_name" Height="24" Padding="3,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Data type" Style="{StaticResource Small}"/>
                        <ComboBox x:Name="data_type" Height="24"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Group in the Properties palette" Style="{StaticResource Small}"/>
                        <ComboBox x:Name="group" Height="24"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Value for the ticked types (optional)" Style="{StaticResource Small}"/>
                <TextBox x:Name="value" Height="24" Padding="3,2"/>
            </StackPanel>
        </Border>

        <!-- log -->
        <TextBox Grid.Row="3" x:Name="log" Margin="16,10,16,0" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>

        <!-- buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10,16,14">
            <Button Content="Close" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True" Click="close_click"/>
            <Button x:Name="add_button" Content="Add Parameter" Width="120" Height="28" IsDefault="True"
                    Background="#2F6FED" Foreground="White" BorderBrush="#2F6FED" Click="add_click"/>
        </StackPanel>
    </Grid>
</Window>

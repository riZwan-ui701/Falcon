<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon - Coloring" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="White">
    <Window.Resources>
        <Style x:Key="Choice" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D2E3"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="What do you want to color?" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
        <Button Style="{StaticResource Choice}" Click="family_click">
            <StackPanel>
                <TextBlock Text="Color Family" FontWeight="SemiBold"/>
                <TextBlock Foreground="#6B7385" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Choose a family, or one of its types, and give it a color. Applies in the project views and their templates, not in 3D (unless you tick the box)."/>
            </StackPanel>
        </Button>
        <Button Style="{StaticResource Choice}" Click="element_click">
            <StackPanel>
                <TextBlock Text="Color Element" FontWeight="SemiBold"/>
                <TextBlock x:Name="element_text" Foreground="#6B7385" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Pick elements in the model (a conduit, a tray, anything) and give them a color."/>
            </StackPanel>
        </Button>
        <Button Content="Close" Width="90" Height="26" HorizontalAlignment="Right" Margin="0,4,0,0"
                IsCancel="True" Click="close_click"/>
    </StackPanel>
</Window>

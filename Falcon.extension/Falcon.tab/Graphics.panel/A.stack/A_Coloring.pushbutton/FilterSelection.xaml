<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filter selection" Width="380" Height="400" MinHeight="260"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="White">
    <DockPanel Margin="12">
        <TextBlock x:Name="intro" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Check all" Width="80" Height="24" Margin="0,0,6,0" Click="check_all"/>
            <Button Content="Uncheck all" Width="80" Height="24" Click="uncheck_all"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="ok_click"
                    Background="#2F6FED" Foreground="White" BorderBrush="#2F6FED"/>
            <Button Content="Cancel" Width="80" Height="26" IsCancel="True" Click="cancel_click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="boxes"/>
        </ScrollViewer>
    </DockPanel>
</Window>

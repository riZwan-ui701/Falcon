<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Dimension Style" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="White">
    <StackPanel Margin="16,14,16,14">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="#1B2540" CornerRadius="6" Width="34" Height="34" Margin="0,0,10,0">
                <TextBlock Text="|-|" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Select Dimension Style" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="Choose the linear style for the outlet dimension chains."
                           Foreground="#6B7385" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <Border Background="#F3F5F9" CornerRadius="6" Padding="12,10">
            <StackPanel>
                <TextBlock Text="LINEAR DIMENSION TYPE" Foreground="#6B7385" FontSize="10" FontWeight="Bold"/>
                <ComboBox x:Name="style" Height="24" Margin="0,6,0,8"/>
                <DockPanel>
                    <TextBlock x:Name="count" DockPanel.Dock="Right" Foreground="#6B7385" FontSize="11"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="show_all" Content="Show all styles" FontSize="11"
                              Checked="show_all_changed" Unchecked="show_all_changed"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Use Style" Width="100" Height="28" IsDefault="True" Click="ok_click"
                    Background="#0E8C7F" Foreground="White" BorderBrush="#0E8C7F"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon - Junction Box" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#F3F5F9">
    <StackPanel>
        <Border Background="#1B2540" Padding="16,12,16,14">
            <StackPanel>
                <TextBlock Text="FALCON" Foreground="#6E9BFF" FontWeight="Bold" FontSize="10"/>
                <TextBlock Text="Junction Box" Foreground="White" FontWeight="Bold" FontSize="20"/>
                <TextBlock Text="Place or update junction boxes at the selected fixtures"
                           Foreground="#C5CCDB" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Background="White" CornerRadius="6" BorderBrush="#E1E5EE" BorderThickness="1"
                Padding="12,10" Margin="14,12,14,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#2F6FED" CornerRadius="10" Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Elevation" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="elevation" Width="260" Height="24" Padding="3,2"/>
                    <TextBlock Text="mm" Foreground="#6B7385" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="level_note" Foreground="#6B7385" FontSize="11" Margin="0,4,0,0"
                           Text="Millimeters above the level"/>
                <TextBlock x:Name="error" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,8,14,12">
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Start" Width="100" Height="28" IsDefault="True" Click="ok_click"
                    Background="#2F6FED" Foreground="White" BorderBrush="#2F6FED"/>
        </StackPanel>
    </StackPanel>
</Window>

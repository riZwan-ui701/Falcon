<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon - Convert Line" Width="440" Height="660" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="#F3F5F9">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E1E5EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7385"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B2540" Padding="16,12,16,14">
            <StackPanel>
                <TextBlock Text="FALCON" Foreground="#6E9BFF" FontWeight="Bold" FontSize="10"/>
                <TextBlock Text="Convert Line" Foreground="White" FontWeight="Bold" FontSize="20"/>
                <TextBlock Text="Turn lines into conduits at the elevation you choose"
                           Foreground="#C5CCDB" FontSize="11"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,0">
            <StackPanel>
                <!-- 1 selection -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource Step}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Selection" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <RadioButton x:Name="mode_pick" GroupName="sel" Content="Select Line" FontWeight="SemiBold" Checked="mode_changed"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Pick the lines you want to convert, then click Finish."/>
                        <RadioButton x:Name="mode_style" GroupName="sel" Content="Line Style" FontWeight="SemiBold" Checked="mode_changed"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Convert every line in the active view that uses the chosen line style."/>
                        <ComboBox x:Name="line_style" Height="24" Margin="20,0,0,6"/>
                        <RadioButton x:Name="mode_cad" GroupName="sel" Content="CAD Lines" FontWeight="SemiBold" Checked="mode_changed"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Pick lines inside a linked or imported DWG, then click Finish."/>
                    </StackPanel>
                </Border>

                <!-- 2 type -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource Step}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Conduit Type" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="ctype" Height="24" SelectionChanged="type_changed"/>
                    </StackPanel>
                </Border>

                <!-- 3 diameter -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource Step}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Conduit Diameter" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="diameter" Height="24"/>
                    </StackPanel>
                </Border>

                <!-- 4 elevation -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource Step}"><TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Elevation" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <RadioButton x:Name="elev_fixed" GroupName="elev" Content="Elevation" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Type the height the conduits are placed at."/>
                        <TextBox x:Name="elevation" Height="24" Margin="20,0,0,2" Padding="3,2"/>
                        <TextBlock x:Name="level_note" Style="{StaticResource Hint}" Text="Millimeters above the level"/>
                        <RadioButton x:Name="elev_circuit" GroupName="elev" Content="Circuit Elevation" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Each conduit takes the height of the panel and the fixtures its line touches. It rises from the top of the panel, then runs at the fixture height."/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="delete_lines" Content="Delete original lines after conversion" Margin="2,0,0,10"/>
                <TextBlock x:Name="error" Foreground="Firebrick" TextWrapping="Wrap" Margin="2,0,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,8,14,12">
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Start" Width="100" Height="28" IsDefault="True" Click="ok_click"
                    Background="#2F6FED" Foreground="White" BorderBrush="#2F6FED"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Falcon - Connect Conduit" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#F3F5F9">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E1E5EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7385"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,0,0,6"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Border Background="#1B2540" Padding="16,12,16,14">
            <StackPanel>
                <TextBlock Text="FALCON" Foreground="#6E9BFF" FontWeight="Bold" FontSize="10"/>
                <TextBlock Text="Connect Conduit" Foreground="White" FontWeight="Bold" FontSize="20"/>
                <TextBlock Text="Route and connect conduits between electrical elements"
                           Foreground="#C5CCDB" FontSize="11"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="14,12,14,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource Step}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Connection" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <RadioButton x:Name="mode_draw" GroupName="mode" Content="Draw New Conduit" FontWeight="SemiBold" Checked="mode_changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Create a new conduit between any two electrical elements or junction boxes. You choose the exit point on the first element; the conduit runs in straight 90-degree legs at that height, then drops onto the second element."/>
                    <RadioButton x:Name="mode_connect" GroupName="mode" Content="Connect Conduit" FontWeight="SemiBold" Checked="mode_changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Select existing conduits and a device. Each conduit continues along its own path, then goes up or down to the device height and connects to it. For a panel, every conduit goes straight into the middle of the panel top and drops to the panel height, without moving sideways."/>
                </StackPanel>
            </Border>

            <Border x:Name="card_diameter" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource Step}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Conduit Diameter" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="diameter" Height="24"/>
                </StackPanel>
            </Border>

            <Border x:Name="card_type" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource Step}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Conduit Type" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="ctype" Height="24" SelectionChanged="type_changed"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="note" Foreground="#6B7385" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,4"
                       Text="In Connect mode the new segments use the diameter and type of the selected conduits."/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,8,14,12">
            <Button Content="Cancel" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True" Click="cancel_click"/>
            <Button Content="Start" Width="100" Height="28" IsDefault="True" Click="ok_click"
                    Background="#2F6FED" Foreground="White" BorderBrush="#2F6FED"/>
        </StackPanel>
    </StackPanel>
</Window>
